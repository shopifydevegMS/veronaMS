{%- comment %} Check sizes image when Shopify update API {%- endcomment %}
<div class="hdt_icon_heading">
  <div class="hdt_icon__header {%  if block.settings.select-design-icon-header-id == "design1" %} ms-icon-header {% endif %} ">
    {% content_for 'blocks' %}
  </div>
</div>

<style>
  .hdt_icon_heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hdt_icon_heading > .hdt_icon__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
   .hdt_icon_heading > .hdt_icon__header.ms-icon-header{
     flex-direction: column;
   }

  .hdt_icon__header > .hdt-heading-block.hdt-s-text {
    line-height: normal;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hdt_icon__header > .hdt-icon-block.hdt-s-text {
    color: rgb(var(--color-accent));
    margin-inline-end: 30px;
  }
  .hdt_icon__header > .hdt-icon-block.hdt-s-text.ms-icon-block{
    width: 134px;
    margin: auto;
    background-color: white;
    height: 134px;
    border-radius: 100%;
    justify-content: center;
    align-items: center;
  }
</style>

{% schema %}
{
  "name": "t:blocks.icon_heading.name",
  "tag": null,
  "settings": [
     {
      "type": "select",
      "id": "select-design-icon-header-id",
      "label": "design",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "default"
        },
        {
          "value": "design1",
          "label": "design1"
        }
      ]
    },
  ],
  "blocks": [
    {
      "type": "icon"
    },
    {
      "type": "heading"
    }
  ],
  "presets": [
    {
      "name": "Icon Heading",
      "blocks": [
        {
          "type": "icon"
        },
        {
          "type": "heading"
        }
      ]
    }
  ]
}
{% endschema %}
