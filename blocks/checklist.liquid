<div id="block-{{ block.id }}" class="hdt-product-info__item ms-checklist{% if block.settings.colors_by_block %} hdt-s-gradient{% endif %}"{% if block.settings.colors_by_block %} color-scheme="{{ block.settings.color_scheme }}"{% endif %} style="{% if block.settings.ms_bg != blank %}--ms-checklist-bg: {{ block.settings.ms_bg }};{% endif %}{% if block.settings.ms_text_color != blank %}--ms-checkitem-text: {{ block.settings.ms_text_color }};{% endif %}--ms-checklist-padding: {{ block.settings.ms_padding | default: '0' }};--ms-checklist-radius: {{ block.settings.ms_radius | default: 0 }}px;" {{ block.shopify_attributes }}>
  {% content_for "blocks" %}
</div>
{% schema %}
{
  "name": "Checklist",
  "tag": null,
  "blocks": [
    {
      "type": "checkitem"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "colors_by_block",
      "label": "Display colors by block"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "visible_if": "{{ block.settings.colors_by_block }}"
    },
    {
      "type": "color",
      "id": "ms_text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "ms_bg",
      "label": "Background color"
    },
    {
      "type": "text",
      "id": "ms_padding",
      "label": "Padding",
      "default": "0"
    },
    {
      "type": "range",
      "id": "ms_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Checklist",
      "blocks": [
        {
          "type": "checkitem"
        },
        {
          "type": "checkitem"
        },
        {
          "type": "checkitem"
        }
      ]
    }
  ]
}
{% endschema %}
